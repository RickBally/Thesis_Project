<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CookbookApp.ViewModels"
             xmlns:mvvm="clr-namespace:MvvmHelpers;assembly=MvvmHelpers"
             xmlns:model="clr-namespace:CookbookApp.Models"
             Title="{Binding Title}"
             x:Name="ShopListPage"
             x:DataType="viewmodels:ShoppingListViewModel"
             Shell.NavBarIsVisible="False"
             x:Class="CookbookApp.Views.ShoppingListPage">
    <ContentPage.BindingContext>
        <viewmodels:ShoppingListViewModel/>
    </ContentPage.BindingContext>
    <ContentPage.Content>
        <Grid BackgroundColor="AntiqueWhite"
              RowDefinitions="*, Auto">
            <CollectionView BackgroundColor="Transparent"
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            ItemsSource="{Binding ShoppingItems}"
                            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                            SelectionChangedCommand="{Binding SelectCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedItem, Mode=TwoWay}"
                            SelectionMode="Single"
                            Margin="0, 10, 0, 10">
                <CollectionView.EmptyView>
                    <Grid Padding="10">
                        <Frame BorderColor="LightGray"
                               HasShadow="True"
                               CornerRadius="20"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               Padding="8">
                            <Label HorizontalTextAlignment="Center"
                                   FontSize="Medium"
                                   Text="Jelenleg nincs semmi a bevásárló listán, érintsd meg a képernyő alján lévő '+' gombot, hogy felvegyél egy hozzávalót!"/>
                        </Frame>
                    </Grid>
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:ShoppingItem">
                        <ContentView>
                            <Grid Margin="0, 3, 0, 3"
                                  BackgroundColor="{Binding ShoppingIng.Category.BGColor}">
                                <BoxView Margin="8, 0, 0, 0"
                                         BackgroundColor="#ffffff"
                                         HorizontalOptions="Fill"
                                         VerticalOptions="Fill"
                                         Opacity="0.6"/>
                                
                                <StackLayout Orientation="Horizontal">
                                    <Image Source="{Binding SelectIcon}"
                                           Margin="17, 0, 0, 0"
                                           HeightRequest="20"/>
                                
                                    <Label Text="{Binding Ammount}"
                                           FontSize="22"
                                           TextColor="Black"
                                           VerticalOptions="Center"/>
                                
                                    <Label Text="{Binding ShoppingIng.Unit}"
                                           FontSize="22"
                                           TextColor="Black"
                                           VerticalOptions="Center"/>
                                
                                    <Label Text="{Binding ShoppingIng.Name}"
                                           FontSize="22"
                                           TextColor="Black"
                                           VerticalOptions="Center"/>
                                </StackLayout>
                            </Grid>
                        </ContentView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <ImageButton Source="button_add.png"
                                 HorizontalOptions="Center"
                                 HeightRequest="75"
                                 BackgroundColor="Transparent"
                                 Command="{Binding AddCommand}"/>
                </CollectionView.Footer>
            </CollectionView>

            <Grid Grid.Row="1"
                  BackgroundColor="Transparent"
                  ColumnDefinitions="Auto, *">
                
                <ImageButton Source="button_pantry.png"
                             Command="{Binding ToPantryCommand}"
                             Margin="50, 0, 0, 25"
                             HeightRequest="75"
                             BackgroundColor="Transparent"
                             IsVisible="{Binding PantryButtonVisible}"/>
                
                <ImageButton Source="button_del.png"
                             Grid.Column="1"
                             HorizontalOptions="End"
                             Margin="0, 0, 50, 25"
                             HeightRequest="75"
                             BackgroundColor="Transparent"
                             Command="{Binding DeleteCommand}"
                             IsVisible="{Binding ClearButtonVisible}"/>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>